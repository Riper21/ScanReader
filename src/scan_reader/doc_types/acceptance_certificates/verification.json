{
  "_comment": "Акт приемки оказанных услуг (выполненных работ).",
  "parties": [
    {"path": "contractor", "label": "исполнитель", "ids": ["inn"]},
    {"path": "customer", "label": "заказчик", "ids": ["inn"]}
  ],
  "identifier_checks": [],
  "money_rules": [
    {
      "code": "ACCEPTANCE_MATH_DISCREPANCY",
      "doc_hint": "акт приемки",
      "total": ["finances.total_rub"],
      "components": [
        ["стоимость без НДС", ["finances.amount_no_vat_rub"]],
        ["НДС", ["finances.vat_amount_rub"]]
