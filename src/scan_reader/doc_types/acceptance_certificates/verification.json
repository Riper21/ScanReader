      "code": "CHRONO_CONTRACT_BEFORE_ACT",
      "message": "Дата договора позже даты подписания акта"
    }
  ],
  "gate_fields": [
    {"path": "finances.total_rub", "min_length": 3},
    {"path": "contractor.inn", "min_length": 10},
    {"path": "customer.inn", "min_length": 10},
    {"path": "doc_number", "min_length": 3}
