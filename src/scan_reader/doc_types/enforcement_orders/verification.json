{
  "_comment": "Заявление о возбуждении ИП и постановление о взыскании на зарплату.",
  "parties": [
    {"path": "claimant", "label": "взыскатель", "ids": ["inn"]},
    {"path": "debtor", "label": "должник", "ids": ["inn"]}
  ],
  "identifier_checks": [],
  "money_rules": [
    {
      "code": "ENFORCEMENT_MATH_DISCREPANCY",
      "doc_hint": "приказ ФССП",
      "total": ["finances.total_rub"],
      "components": [
        ["основной долг", ["finances.main_debt_rub"]],
        ["судебные расходы", ["finances.court_costs_rub"]]
      ],
      "min_components": 2,
      "tolerance": 0.05,
      "severity": "error"
    }
  ],
  "chronology_rules": [
    {
      "before": ["court.act_date|court.issue_date"],
      "after": ["doc_date"],
      "code": "CHRONO_ACT_BEFORE_ORDER",
      "message": "Дата судебного акта позже даты постановления о взыскании"
    }
  ],
  "gate_fields": [
    {"path": "finances.total_rub", "min_length": 3},
    {"path": "finances.main_debt_rub", "min_length": 3},
    {"path": "claimant.inn", "min_length": 10},
    {"path": "debtor.inn", "min_length": 10},
    {"path": "ip_number", "min_length": 5},
    {"path": "reg_number", "min_length": 3},
    {"path": "court.case_number", "min_length": 5}
  ],
  "gate_names": ["claimant.name", "debtor.name"],
  "gate_authorities": ["fssp.name", "court.name"],
  "recovery": {
    "_comment": "P2.1: резервное восстановление сумм. Итог восстанавливаем всегда; долг и судебные расходы — только в объявленные, но пустые поля. Судебные расходы восстанавливаются категорией court_fee_rub: сканер не различает пошлину и издержки.",
    "total_fields": ["finances.total_rub"],
    "fields": [
      {"path": "finances.total_rub", "source": "total_rub", "always": true},
      {"path": "finances.main_debt_rub", "source": "main_debt_rub", "fallback_source": "total_rub"},
      {"path": "finances.court_costs_rub", "source": "court_fee_rub"}
    ]
  }
}
