{
  "fields": [
    {
      "field": "claimant.name",
      "rule": "not_empty",
      "severity": "CRITICAL",
      "message": "Взыскатель должен быть обязательно указан"
    },
    {
      "field": "debtor.name",
      "rule": "not_empty",
      "severity": "CRITICAL",
      "message": "Должник должен быть обязательно указан"
    },
    {
      "field": "doc_date",
      "rule": "valid_date_format",
      "severity": "HIGH",
      "message": "Дата документа должна быть в формате ДД.ММ.ГГГГ"
    },
    {
      "field": "ip_number",
      "rule": "ip_number_format_optional",
      "severity": "MEDIUM",
      "message": "Номер ИП должен иметь формат NNNNN/NN/NNNNN-ИП (со слэшами), если указан"
    }
  ]
}
