# ==============================================================================
# КОНФИГУРАЦИЯ СТОРОННИХ МОДЕЛЕЙ (VLM / LLM) ДЛЯ РАСПОЗНАВАНИЯ ДОКУМЕНТОВ
# Скопируйте этот файл в .env и заполните нужные параметры
# ==============================================================================

# ВАЖНО: клиент работает ТОЛЬКО по OpenAI-совместимому протоколу (/v1/chat/completions).
# Google Gemini напрямую не поддерживается — используйте его через прокси с
# OpenAI-совместимым API (OpenRouter, LiteLLM и т.п.).

# 1. Вариант OpenAI (или совместимые сервисы: DeepSeek, OpenRouter, LiteLLM)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Для DeepSeek / OpenRouter раскомментируйте соответствующий URL:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_NAME=gpt-4o-mini

# 2. Вариант локальной модели Ollama (Qwen2.5-VL, Llama3.2-Vision) — по умолчанию
OPENAI_BASE_URL=http://localhost:11434/v1
AI_MODEL_NAME=qwen2.5-vl:7b
OPENAI_API_KEY=dummy_local_key

# 3. Вариант локального сервера vLLM / SGLang / LM Studio
# OPENAI_BASE_URL=http://localhost:8000/v1
# AI_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ==============================================================================
# НАСТРОЙКИ КОНВЕЙЕРА (необязательные)
# ==============================================================================

# Таймаут одного запроса к VLM/LLM в секундах (по умолчанию 600)
# VLM_TIMEOUT=600

# Лимит запросов в минуту к модели (RPM, по умолчанию 60)
# VLM_RPM_LIMIT=60

# Максимальный параллелизм запросов к модели (по умолчанию 2)
# VLM_MAX_CONCURRENCY=2

# Включение RateLimiter (true/false, по умолчанию true)
# ENABLE_RATE_LIMITER=true

# Включение файлового кэша ответов VLM (true/false, по умолчанию true)
# ENABLE_CACHE=true

# Каталог кэша (по умолчанию ./.cache/scan_reader)
# SCANREADER_CACHE_DIR=

# Максимальное число записей в кэше (по умолчанию 2000, вытеснение FIFO)
# SCANREADER_MAX_CACHE_ENTRIES=2000

# Каталог результатов (по умолчанию ./output)
# SCANREADER_OUTPUT_DIR=

# Каталог входящих документов для пакетной обработки (по умолчанию ./incoming)
# SCANREADER_INCOMING_DIR=

# Каталог эталонов Ground Truth (по умолчанию ./data/ground_truth)
# SCANREADER_GROUND_TRUTH_DIR=

# Разрешенные корни для доступа к файлам через JSON-RPC сервер (разделитель ';' на Windows)
# SCANREADER_ALLOWED_DIRS=

# Корень данных лаунчера (по умолчанию корень проекта)
# SCANREADER_HOME=

# Уровень логирования (DEBUG / INFO / WARNING / ERROR, по умолчанию INFO)
# LOG_LEVEL=INFO

# Отключение ANSI-цветов в выводе CLI
# NO_COLOR=1
