# ==============================================================================
# КОНФИГУРАЦИЯ СТОРОННИХ МОДЕЛЕЙ (VLM / LLM) ДЛЯ РАСПОЗНАВАНИЯ ДОКУМЕНТОВ
# Скопируйте этот файл в .env и заполните нужные параметры
# ==============================================================================

# ВАЖНО: клиент работает ТОЛЬКО по OpenAI-совместимому протоколу (/v1/chat/completions).
# Google Gemini напрямую не поддерживается — используйте его через прокси с
# OpenAI-совместимым API (OpenRouter, LiteLLM и т.п.).

# 1. Вариант OpenAI (или совместимые сервисы: DeepSeek, OpenRouter, LiteLLM)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Для DeepSeek / OpenRouter раскомментируйте соответствующий URL:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_NAME=gpt-4o-mini

# 2. Вариант локальной модели Ollama (Qwen2.5-VL, Llama3.2-Vision) — по умолчанию
OPENAI_BASE_URL=http://localhost:11434/v1
AI_MODEL_NAME=qwen2.5-vl:7b
OPENAI_API_KEY=dummy_local_key

# 3. Вариант локального сервера vLLM / SGLang / LM Studio
# OPENAI_BASE_URL=http://localhost:8000/v1
# AI_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ==============================================================================
# НАСТРОЙКИ КОНВЕЙЕРА (необязательные)
# ==============================================================================

# Таймаут одного запроса к VLM/LLM в секундах (по умолчанию 600)
# VLM_TIMEOUT=600

# Лимит запросов в минуту к модели (RPM, по умолчанию 60)
# VLM_RPM_LIMIT=60

# Максимальный параллелизм запросов к модели (по умолчанию 2)
# VLM_MAX_CONCURRENCY=2

# Включение RateLimiter (true/false, по умолчанию true)
# ENABLE_RATE_LIMITER=true

# Включение файлового кэша ответов VLM (true/false, по умолчанию true)
# ENABLE_CACHE=true

# Каталог кэша (по умолчанию ./.cache/scan_reader)
# SCANREADER_CACHE_DIR=

# Максимальное число записей в кэше (по умолчанию 2000, вытеснение LRU:
# первой удаляется наименее недавно использованная, а не первая по порядку вставки)
# SCANREADER_MAX_CACHE_ENTRIES=2000

# Сколько записей копить перед сбросом кэша на диск (по умолчанию 25).
# Сброс выполняется вне блокировки; раньше он делался на каждую вставку под
# замком, что давало квадратичную работу за прогон.
# SCANREADER_CACHE_FLUSH_EVERY=25

# Максимальный интервал между сбросами кэша на диск в секундах (по умолчанию 30).
# Гарантированный сброс дают flush(), close() и контекстный менеджер.
# SCANREADER_CACHE_FLUSH_SECONDS=30

# Сколько страниц документа уходит в один мультимодальный запрос (по умолчанию 20).
# Без ограничения весь PDF превращался в один запрос на десятки мегабайт base64,
# который заведомо не помещается в контекст модели.
# SCANREADER_MAX_PAGES=20

# Каталог результатов (по умолчанию ./output)
# SCANREADER_OUTPUT_DIR=

# Каталог входящих документов для пакетной обработки (по умолчанию ./incoming)
# SCANREADER_INCOMING_DIR=

# Каталог эталонов Ground Truth (по умолчанию ./data/ground_truth)
# SCANREADER_GROUND_TRUTH_DIR=

# Разрешенные корни для доступа к файлам через JSON-RPC сервер (разделитель ';' на Windows)
# SCANREADER_ALLOWED_DIRS=

# Корень данных лаунчера (по умолчанию корень проекта)
# SCANREADER_HOME=

# ---------------------------------------------------------------------------
# OCR И КРОСС-МОДАЛЬНАЯ ВЕРИФИКАЦИЯ СКАНОВ
# ---------------------------------------------------------------------------
# Независимый OCR-канал для подтверждения реквизитов по изображению.
# Требует установки: pip install "scan-reader[ocr]"  (или "scan-reader[ocr-full]")
# Без него гейт для сканов опирается на VLM-транскрипцию, которая НЕ является
# независимой сверкой (та же модель, что и извлечение).
# SCANREADER_OCR_ENABLED=true

# Движок OCR: auto (быстрый поиск) | rapidocr (ONNX, CPU) | paddleocr (GPU)
# SCANREADER_OCR_ENGINE=auto

# Язык распознавания для PaddleOCR
# SCANREADER_OCR_LANG=ru

# Сколько страниц разбирать OCR'ом за один проход (по умолчанию 5).
# Для многостраничных исполнительных листов обычно хватает первых страниц.
# SCANREADER_OCR_MAX_PAGES=5

# Минимальная длина распознанного текста, чтобы считать страницу пригодной
# без OCR (если текстовый слой короче, страница распознаётся изображением).
# SCANREADER_OCR_MIN_TEXT_LENGTH=50

# Резервный проход VLM «точная транскрипция», когда OCR недоступен.
# Полезен, но это НЕ независимая сверка: в отчёте помечается
# gate_source=vlm_transcription и GATE_REFERENCE_FROM_VLM.
# SCANREADER_OCR_CROSSCHECK=true

# Уровень логирования (DEBUG / INFO / WARNING / ERROR, по умолчанию INFO)
# LOG_LEVEL=INFO

# Отключение ANSI-цветов в выводе CLI
# NO_COLOR=1
